# ===== 旅行 Agent 环境变量模板 =====
# 复制为 .env 并填入真实值：cp .env.example .env

# LLM（火山方舟 / OpenAI 兼容接口）
# 火山方舟：https://www.volcengine.com/product/ark
# base_url 形如 https://ark.cn-beijing.volces.com/api/v3
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=...
# 模型名，如 deepseek-v4-flash / doubao-... 等
LLM_MODEL=deepseek-v4-flash
# 可选：规划节点用更强模型；不填则统一用 LLM_MODEL
PLANNER_MODEL=

# Amadeus（机票/酒店搜索与下单）
# 在 https://developers.amadeus.com 注册申请
AMADEUS_CLIENT_ID=...
AMADEUS_CLIENT_SECRET=...
# test = 测试环境（只能搜索，下单返回假 PNR，不扣款）
# prod = 生产环境（真实出票扣款，需生产授权）
AMADEUS_ENV=test

# Google Places（景点/餐厅）
GOOGLE_PLACES_API_KEY=...

# OpenWeather（天气）
OPENWEATHER_API_KEY=...

# 汇率（可选，免费层够用）
EXCHANGE_RATE_API_KEY=...

# OSRM 路线服务地址（可选，默认用公共实例）
# 自建：docker run -p 5000:5000 osrm/osrm-backend osrm-routed .../osrm
OSRM_BASE_URL=http://router.project-osrm.org

# 应用
STREAMLIT_SERVER_PORT=8501
# 日志级别 DEBUG/INFO/WARNING/ERROR
LOG_LEVEL=INFO
